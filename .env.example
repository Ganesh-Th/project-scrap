# AI Review Intelligence System Environment Configuration
# Copy this file to .env and update with your values

# SerpAPI Configuration
# Get your API key from: https://serpapi.com/
# Use "demo_key" for testing with mock data
SERPAPI_KEY=demo_key

# Database Configuration (used by Docker Compose)
POSTGRES_DB=review_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional: Customize ports if needed
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
